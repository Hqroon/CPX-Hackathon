# Copy this file to .env and fill in the values. NEVER commit .env.
PORT=8787

# Where the videos are. Default: backend/media/reels and backend/media/thumbs.
# Point these at any folder (absolute path) to use videos stored elsewhere.
# REELS_DIR=D:\videos\doomscroll
# THUMBS_DIR=D:\videos\doomscroll\thumbs

# Order in which providers are tried for question generation.
# Any provider without a key is skipped automatically.
PROVIDER_ORDER=amd,aihubmix,tokener

# AMD Token Factory: https://developer.amd.com.cn/radeon/tokenfactory
# Confirm the base URL and model name in their docs.
AMD_TF_BASE_URL=
AMD_TF_API_KEY=
AMD_TF_MODEL=

# AIHubMix: https://aihubmix.com (redeem the code, then create an API key)
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_API_KEY=
AIHUBMIX_MODEL=

# Tokener: https://www.tokener.ai/zh/docs
TOKENER_BASE_URL=
TOKENER_API_KEY=
TOKENER_MODEL=

# Seconds to wait for each provider before trying the next one
PROVIDER_TIMEOUT_S=20
