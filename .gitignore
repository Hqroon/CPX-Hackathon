# Dependencies and builds
node_modules/
dist/

# Secrets: never commit API keys
.env
.env.*
!.env.example
!.env.*.example

# Media lives on the server, not in git (licences + repo size)
backend/media/reels/*
!backend/media/reels/.gitkeep
backend/media/thumbs/*
!backend/media/thumbs/.gitkeep
raw/
music/
frontend/public/reels/
frontend/public/thumbs/

# Android build outputs (the android/ project itself is committed)
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
*.apk
*.aab

# Event logs from the volunteer test
backend/data/events.jsonl

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
