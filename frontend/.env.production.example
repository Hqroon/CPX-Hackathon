# Copy to .env.production before building the Android APK.

# Backend address the phone can reach (laptop IP on the same hotspot, or a hosted server).
# Find the laptop IP on Windows with:  ipconfig   (look for the Wi-Fi IPv4 address)
VITE_API_BASE=http://192.168.43.10:8787

# true = the 50 videos are packed inside the APK (run `npm run bundle:media` first).
# The feed then works even with no network; only question generation needs the backend
# (and falls back to built-in questions if it can't reach it).
VITE_BUNDLED_MEDIA=true
