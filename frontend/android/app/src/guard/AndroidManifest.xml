<?xml version="1.0" encoding="utf-8"?>
<!-- Extra manifest entries for the "guard" variant only. Merged into src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+: lets us check which guarded apps are installed and open them. -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.smile.gifmaker" />
    </queries>

    <application>
        <service
            android:name="com.cpx.doomscrolltax.guard.ReelGuardService"
            android:exported="true"
            android:label="@string/guard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/reel_guard_service" />
        </service>
    </application>
</manifest>
